# Postgres (docker compose bilan ko'tariladi)
DATABASE_URL="postgresql://agents:agents_dev@localhost:5433/agents?schema=public"

# LLM manbasi.
#   hermes (standart) — ~/.hermes dagi model (gemini-3.6-flash, bepul)
#   cli               — lokal `claude` CLI (Claude Code obunasidan)
#   api            — to'g'ridan-to'g'ri Anthropic API (ANTHROPIC_API_KEY talab qiladi)
LLM_BACKEND="hermes"
ANTHROPIC_API_KEY=""

# Arzon ishlar uchun model (niyat aniqlash, saralash)
LLM_CHEAP_MODEL="haiku"

# Engine chegaralari
ENGINE_MAX_STEPS=50
ENGINE_MAX_COST_USD=2.0

# Telegram (2-qadamda ishlatiladi) — har agentga alohida bot
TG_OWNER_CHAT_ID=""
TG_BOT_TOKEN_SALES=""
TG_BOT_TOKEN_RESEARCH=""
TG_BOT_TOKEN_CONTENT=""
TG_BOT_TOKEN_BOSS=""

# Research Agent qidiruvi: Google (asosiy) + hh.uz/frilanser/LinkedIn (Google
# site: orqali, qo'shimcha qamrov). DuckDuckGo ishlatilmaydi.
#
# Google: GOOGLE_SEARCH_API_KEY + GOOGLE_SEARCH_CX sozlansa haqiqiy Custom
# Search API ishlatiladi (tavsiya etiladi — captcha yo'q, bepul tarif 100
# so'rov/kun). Sozlanmasa Chrome orqali scraping zahira sifatida ishlaydi
# (captcha xavfi bor). Olish: https://programmablesearchengine.google.com/
# (CX yarating, "Search the entire web" yoqing) + Google Cloud Console'da
# "Custom Search API" kalitini oling.
# GOOGLE_SEARCH_API_KEY=""
# GOOGLE_SEARCH_CX=""
#
# LinkedIn (kompaniya/profil sahifalarini o'qish uchun, Chrome orqali):
# birinchi marta login kerak bo'lsa server o'zi ko'rinadigan oyna ochadi;
# oldindan qulay vaqtda login qilish uchun scripts/chrome-linkedin.ps1
# (Windows) / .sh (macOS) ham bor. Quyidagilar ixtiyoriy — bo'sh qoldirilsa
# oqilona standart qiymat ishlatiladi (OS avtomatik aniqlanadi).
# CHROME_BIN=""
# LINKEDIN_PROFILE_DIR=""
# LINKEDIN_HEADED="0"
# LINKEDIN_HOURLY_LIMIT=25

# Sales Agent — Telegram USER akkaunt (bot emas, MTProto/teleproto). Bot API
# botlardan farqli, bu odamga BIRINCHI bo'lib yoza oladi (lead'ning raqamiga).
# TELEGRAM_API_ID / TELEGRAM_API_HASH: https://my.telegram.org/apps dan
# (shu Sales akkaunt sifatida ishlatiladigan raqamga bog'langan holda).
# TELEGRAM_API_ID=""
# TELEGRAM_API_HASH=""
# Bir martalik interaktiv login bilan to'ldiriladi: `pnpm sales:login`
# (telefon kodi so'raydi). Qo'lda yozmang.
# SALES_TG_SESSION=""

# CEO tasdiq-tugmasi (Accept/Reject) shu chat(lar)ga boradi — uchrashuv vaqtini
# tasdiqlash uchun. Bir yoki bir nechta chat ID, vergul bilan ajratilgan
# (masalan Sardor + boshqa CEO) — ikkisidan BIRI bossa yetarli.
# CEO_CHAT_ID="111111111,222222222"

# Sales akkaunt (MTProto, yuqoridagi SALES_TG_SESSION) orqali qaror qabul
# qiluvchilarga (Sardor, boshqa CEO) shaxsiy xabar yuborish — masalan
# "qaysi leadga yozay?" degan savol uchun (bu yerda bot-tugma ISHLATILMAYDI,
# javob oddiy matn/harf bo'ladi). Format: "label:telefon,label:telefon".
# SALES_CEO_CONTACTS="sardor:+998901234567,ceo2:+998907654321"
